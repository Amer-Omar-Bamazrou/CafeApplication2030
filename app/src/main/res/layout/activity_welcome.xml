<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".ui.auth.WelcomeActivity">

    <ImageView
        android:id="@+id/imageViewWelcome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/coffee_welcome"
        android:contentDescription="Full screen background" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="bottom"
        android:background="#77000000">

        <TextView
            android:id="@+id/textWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Discover Your Coffee"
            android:textSize="38sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/textSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The journey begins with a single perfect cup."
            android:textSize="18sp"
            android:textColor="#CFCFCF"
            android:layout_marginBottom="48dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/buttonWelcomeSignIn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sign In"
                android:textSize="18sp"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#8D6E63"/>

            <Button
                android:id="@+id/buttonWelcomeSignUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sign Up"
                android:textSize="18sp"
                android:padding="12dp"
                android:layout_marginStart="8dp"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="@android:color/white"
                app:strokeColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
