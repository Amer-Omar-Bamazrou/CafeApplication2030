<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    android:backgroundTint="@color/luxury_card_cream"
    app:strokeColor="@color/luxury_brown"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/image_view_cart_item"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/image_placeholder_bg"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/backgrounds/scenic" />

        <TextView
            android:id="@+id/text_view_item_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/luxury_dark_brown"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/button_remove_item"
            app:layout_constraintStart_toEndOf="@id/image_view_cart_item"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Spanish Latte" />

        <TextView
            android:id="@+id/text_view_item_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="6dp"
            android:textColor="@color/luxury_brown"
            android:textSize="16sp"
            app:layout_constraintStart_toEndOf="@id/image_view_cart_item"
            app:layout_constraintTop_toBottomOf="@id/text_view_item_name"
            tools:text="$5.80" />

        <ImageButton
            android:id="@+id/button_remove_item"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Remove"
            android:padding="4dp"
            android:src="@drawable/ic_delete_luxury"
            app:tint="@color/luxury_brown"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/quantity_controls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/button_remove_item">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_decrease_quantity"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/luxury_brown"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_minus"
                app:iconTint="@android:color/white" />

            <TextView
                android:id="@+id/text_view_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:textColor="@color/luxury_dark_brown"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_increase_quantity"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:backgroundTint="@color/luxury_brown"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_plus"
                app:iconTint="@android:color/white" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
