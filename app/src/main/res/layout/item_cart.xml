<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <ImageView
            android:id="@+id/image_view_cart_item"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:background="#E0E0E0"
            android:contentDescription="@string/product_image_desc"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/text_view_item_name"
            android:layout_width="246dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/button_remove_item"
            app:layout_constraintStart_toEndOf="@id/image_view_cart_item"
            app:layout_constraintTop_toTopOf="@id/image_view_cart_item"
            tools:text="Long Product Name That Wraps" />

        <TextView
            android:id="@+id/text_view_item_price"
            android:layout_width="125dp"
            android:layout_height="30dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@+id/button_remove_item"
            app:layout_constraintHorizontal_bias="0.016"
            app:layout_constraintStart_toEndOf="@id/image_view_cart_item"
            app:layout_constraintTop_toBottomOf="@id/text_view_item_name"
            tools:text="$4.50 / each" />

        <ImageButton
            android:id="@+id/button_remove_item"
            android:layout_width="41dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/remove_item"
            android:src="@android:drawable/ic_menu_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/button_decrease_quantity"
            android:layout_width="40dp"
            android:layout_height="37dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/color_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_delete"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/text_view_quantity"
            app:layout_constraintEnd_toStartOf="@+id/text_view_quantity"
            app:layout_constraintTop_toTopOf="@+id/text_view_quantity" />

        <TextView
            android:id="@+id/text_view_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/button_increase_quantity"
            tools:text="2" />

        <Button
            android:id="@+id/button_increase_quantity"
            android:layout_width="41dp"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/color_secondary"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:cornerRadius="8dp"
            app:icon="@android:drawable/ic_input_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/text_view_quantity"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/text_view_quantity" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>