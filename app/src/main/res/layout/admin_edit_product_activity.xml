<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5EFE6"
    android:padding="20dp"
    tools:context=".ui.admin.AdminEditProductActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/titleEditProduct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Product"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#291C0E"
            android:fontFamily="serif"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/image_product_preview"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="20dp"
            android:background="@drawable/image_placeholder_bg"
            android:contentDescription="Product Image Preview" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="8dp"
            android:backgroundTint="#E1D4C2"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Product Name"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#6E473B"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_product_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#291C0E"
                        android:inputType="textCapWords" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Price"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#6E473B"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_product_price"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#291C0E"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Image URL"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="#6E473B"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_text_product_image_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#291C0E"
                        android:inputType="textUri" />
                </com.google.android.material.textfield.TextInputLayout>

                <CheckBox
                    android:id="@+id/checkbox_is_available"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Available"
                    android:textSize="18sp"
                    android:textColor="#291C0E"
                    android:checked="true"
                    android:layout_marginBottom="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_update_product"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Update Product"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:backgroundTint="#6E473B"
                    app:cornerRadius="16dp"
                    android:padding="12dp"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</ScrollView>
