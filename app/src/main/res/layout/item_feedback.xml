<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- This TextView MUST have the id "text_view_feedback_order_id" -->
        <TextView
            android:id="@+id/text_view_feedback_order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Order ID: 12345ABC" />

        <!-- This TextView MUST have the id "text_view_feedback_rating" -->
        <TextView
            android:id="@+id/text_view_feedback_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp"
            tools:text="Rating: 5 / 5" />

        <!-- This TextView MUST have the id "text_view_feedback_comment" -->
        <TextView
            android:id="@+id/text_view_feedback_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            tools:text="The coffee was absolutely amazing! Will definitely order again." />

    </LinearLayout>

</androidx.cardview.widget.CardView>
