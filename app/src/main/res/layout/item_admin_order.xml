<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    android:backgroundTint="@color/luxury_card_cream"
    app:strokeColor="@color/luxury_brown"
    app:strokeWidth="1dp">

    <LinearLayout
        android:orientation="vertical"
        android:padding="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/text_view_order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#6E473B"
            android:textStyle="italic"
            tools:text="Order ID: xfA123B..." />

        <TextView
            android:id="@+id/text_view_customer_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textColor="#291C0E"
            android:layout_marginTop="6dp"
            tools:text="Customer: yzK456C..." />

        <TextView
            android:id="@+id/text_view_total_quantity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#291C0E"
            android:layout_marginTop="10dp"
            tools:text="3 Items" />

        <TextView
            android:id="@+id/text_view_order_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#6E473B"
            android:layout_marginTop="4dp"
            tools:text="Total: $12.75" />

        <TextView
            android:id="@+id/text_view_order_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#291C0E"
            android:padding="6dp"
            android:layout_marginTop="12dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/status_badge"
            tools:text="Pending" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_marginTop="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_set_preparing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preparing"
                android:textColor="@android:color/white"
                android:backgroundTint="#6E473B"
                app:cornerRadius="12dp"
                android:layout_marginEnd="6dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_set_collect"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Completed"
                android:textColor="@android:color/white"
                android:backgroundTint="#291C0E"
                app:cornerRadius="12dp"
                android:layout_marginStart="6dp"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
