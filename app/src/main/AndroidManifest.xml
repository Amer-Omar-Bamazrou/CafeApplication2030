<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CafeShopApplication">

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.UserLogin"
            android:exported="false" />

        <activity
            android:name=".ui.auth.userSignUp"
            android:exported="false" />

        <activity
            android:name=".ui.auth.WelcomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.admin.AdminDashboardActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminViewOrdersActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminAddProductActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminManageMenuActivity"
            android:exported="false" />

        <activity
            android:name=".ui.admin.AdminEditProductActivity"
            android:exported="false" />

        <activity
            android:name=".ui.menu.ItemDetailsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.order.OrderStatusActivity"
            android:exported="false" />

        <activity
            android:name=".ui.feedback.FeedbackActivity"
            android:exported="false" />

    </application>

</manifest>